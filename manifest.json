{
  "manifest_version": 3,
  "name": "Threat Intelligence",
  "version": "1.0.0",
  "description": "IOC extraction and enrichment for SOC analysts. Parses IPs, hashes, domains, URLs, CVEs, MITRE IDs and more from any page, then enriches with VirusTotal, AbuseIPDB, RDAP, DNS, and geolocation.",
  "action": {
    "default_title": "Threat Intelligence",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "activeTab",
    "scripting",
    "clipboardWrite",
    "contextMenus",
    "tabs",
    "offscreen"
  ],
  "host_permissions": [
    "https://www.virustotal.com/*",
    "https://api.virustotal.com/*",
    "https://api.abuseipdb.com/*",
    "https://api.greynoise.io/*",
    "https://ipwho.is/*",
    "http://ip-api.com/*",
    "https://ip-api.com/*",
    "https://dns.google/*",
    "https://rdap.org/*",
    "https://rdap.arin.net/*",
    "https://rdap.iana.org/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/parser.js", "lib/markdown.js", "content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
